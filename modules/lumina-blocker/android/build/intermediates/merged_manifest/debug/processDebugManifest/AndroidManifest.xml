<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.luminablocker" >

    <uses-sdk android:minSdkVersion="24" />

    <!--
    SYSTEM_ALERT_WINDOW — required for BreathOverlayService to draw a
    TYPE_APPLICATION_OVERLAY window on top of Instagram, YouTube, etc.
    User must grant this manually via Settings → Apps → Lumina →
    "Display over other apps". We prompt them from AppPickerScreen.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
    FOREGROUND_SERVICE — required on Android 9+ to start a service
    that remains alive while another app is in the foreground.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!--
    Query any launchable app — required on Android 11+ (API 30+) for
    getInstalledApps() to return the full list via queryIntentActivities().
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />

            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>

        <!--
      Accessibility service — detects when a blocked app comes to foreground.
      Requires the user to enable it in Settings → Accessibility → Lumina.
        -->
        <service
            android:name="expo.modules.luminablocker.LuminaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            tools:replace="android:exported" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lumina_accessibility_config" />
        </service>

        <!--
      Overlay service — draws the breath screen as a SYSTEM WINDOW on top
      of any app. Does NOT switch the user to the Lumina app.
      Replaces BreathOverlayActivity entirely.
        -->
        <service
            android:name="expo.modules.luminablocker.BreathOverlayService"
            android:exported="false" />

        <!--
      BreathOverlayActivity is kept ONLY for in-app preview/onboarding
      (e.g. showing the user what the overlay looks like before they
      enable the service). It is no longer used as the real overlay.
      Remove this entry entirely if you don't need an in-app preview.
        -->
        <!--
         <activity
        android:name="expo.modules.luminablocker.BreathOverlayActivity"
        android:exported="false"
        android:excludeFromRecents="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        -->

    </application>

</manifest>