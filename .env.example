# Copy this file to .env.local and add your own key.
# Direct prototype mode embeds this key in the mobile bundle. Do not use this
# approach for a public production build.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_OPENROUTER_MODEL=openrouter/free
